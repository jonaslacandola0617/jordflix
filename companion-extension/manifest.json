{
  "manifest_version": 3,
  "name": "Jordflix Companion",
  "version": "0.1.0",
  "description": "Lightweight popup protection for Jordflix playback servers.",
  "permissions": [
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://jordflix.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://jordflix.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
