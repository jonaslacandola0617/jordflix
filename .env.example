# Preferred: TMDB v4 Read Access Token (server-only)
TMDB_API_TOKEN=

# Optional fallback: TMDB v3 API key (server-only)
TMDB_API_KEY=

# Used for regional streaming availability. PH = Philippines.
DEFAULT_REGION=PH

# Public production URL for canonical metadata/sitemap.
NEXT_PUBLIC_SITE_URL=https://jordflix.vercel.app

# -----------------------------------------------------------------------------
# Playback servers
# -----------------------------------------------------------------------------
# Server 1 remains backward compatible with the original Jordflix variables.
# Existing deployments can keep these unchanged.
PLAYBACK_MOVIE_EMBED_TEMPLATE=https://player.sample/embed/movie/{id}
PLAYBACK_TV_EMBED_TEMPLATE=https://player.sample/embed/tv/{id}/{season}/{episode}

# Scalable server slots. Configure only the servers you actually operate/use.
# Supported placeholders: {type}, {id}, {tmdbId}, {season}, {episode}.
# PLAYBACK_SERVER_1_* overrides the legacy Server 1 values above when present.

PLAYBACK_SERVER_1_LABEL=Server 1
PLAYBACK_SERVER_1_MOVIE_TEMPLATE=
PLAYBACK_SERVER_1_TV_TEMPLATE=

PLAYBACK_SERVER_2_LABEL=Server 2
PLAYBACK_SERVER_2_MOVIE_TEMPLATE=
PLAYBACK_SERVER_2_TV_TEMPLATE=

PLAYBACK_SERVER_3_LABEL=Server 3
PLAYBACK_SERVER_3_MOVIE_TEMPLATE=
PLAYBACK_SERVER_3_TV_TEMPLATE=

PLAYBACK_SERVER_4_LABEL=Server 4
PLAYBACK_SERVER_4_MOVIE_TEMPLATE=
PLAYBACK_SERVER_4_TV_TEMPLATE=

PLAYBACK_SERVER_5_LABEL=Server 5
PLAYBACK_SERVER_5_MOVIE_TEMPLATE=
PLAYBACK_SERVER_5_TV_TEMPLATE=

PLAYBACK_SERVER_6_LABEL=Server 6
PLAYBACK_SERVER_6_MOVIE_TEMPLATE=
PLAYBACK_SERVER_6_TV_TEMPLATE=

PLAYBACK_SERVER_7_LABEL=Server 7
PLAYBACK_SERVER_7_MOVIE_TEMPLATE=
PLAYBACK_SERVER_7_TV_TEMPLATE=

# Optional direct MP4/HLS playback instead of an iframe embed.
# Jordflix replaces {type} with movie/tv and {id}/{tmdbId} with the TMDB title ID.
# Example: https://media.example.com/library/{type}/{id}/video.mp4
PLAYBACK_URL_TEMPLATE=
