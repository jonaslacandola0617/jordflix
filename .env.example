# Preferred: TMDB v4 Read Access Token (server-only)
TMDB_API_TOKEN=

# Optional fallback: TMDB v3 API key (server-only)
TMDB_API_KEY=

# Used for regional streaming availability. PH = Philippines.
DEFAULT_REGION=PH

# Public production URL for canonical metadata/sitemap.
NEXT_PUBLIC_SITE_URL=https://jordflix.vercel.app

# Optional: authorized/self-hosted media playback.
# Jordflix replaces {type} with movie/tv and {id}/{tmdbId} with the TMDB title ID.
# Example: https://media.example.com/library/{type}/{id}/video.mp4
# Browser-compatible HLS (.m3u8) can also be used where supported.
PLAYBACK_URL_TEMPLATE=
