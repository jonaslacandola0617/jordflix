# Preferred: TMDB v4 Read Access Token (server-only)
TMDB_API_TOKEN=

# Optional fallback: TMDB v3 API key (server-only)
TMDB_API_KEY=

# Used for regional streaming availability. PH = Philippines.
DEFAULT_REGION=PH

# Public production URL for canonical metadata/sitemap.
NEXT_PUBLIC_SITE_URL=https://jordflix.vercel.app

# Self-hosted iframe player routes.
# These defaults mirror the temporary sample structure used during development.
# Replace player.sample with the working host when your player is ready.
PLAYBACK_MOVIE_EMBED_TEMPLATE=https://player.sample/embed/movie/{id}
PLAYBACK_TV_EMBED_TEMPLATE=https://player.sample/embed/tv/{id}/{season}/{episode}

# Optional direct MP4/HLS playback instead of an iframe embed.
# Jordflix replaces {type} with movie/tv and {id}/{tmdbId} with the TMDB title ID.
# Example: https://media.example.com/library/{type}/{id}/video.mp4
PLAYBACK_URL_TEMPLATE=
